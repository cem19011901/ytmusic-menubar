{
  "manifest_version": 3,
  "name": "YTMusic MenuBar",
  "version": "1.0.0",
  "description": "YouTube Music'i macOS menu bar'a taşır",
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["*://music.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
